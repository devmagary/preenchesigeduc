    "harness": "node trabalho/harness.mjs"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "archiver": "^7.0.1",
    "jsdom": "^26.0.0",
    "playwright-core": "^1.50.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
