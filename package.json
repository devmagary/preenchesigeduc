{
  "name": "preenche-sigeduc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Extensão MV3 para Chrome Desktop e navegadores Android compatíveis para importação de notas, frequências e scraping contextual no SIGEduc-BA.",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "test:unit": "vitest run",
    "benchmark": "node trabalho/benchmark.mjs",
    "test:e2e": "node tests/e2e/extension.spec.mjs",
